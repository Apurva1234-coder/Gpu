    {
      "area": "MILP presolve integration",
      "summary": "Branch-and-bound now solves the integer-safe presolved model, postsolves the incumbent through fixed-variable and continuous-substitution history, recomputes the original objective, and verifies original bounds, integrality, and constraints."
    },
    {
      "area": "Integer semantic safety",
      "summary": "Integer singleton bounds round inward; empty integer domains/nonintegral singleton equalities are detected; integer equality variables are not substituted."
    },
    {
      "area": "Sparse root LP dispatch",
      "summary": "Avoid eager dense standardization when the root exceeds the existing 256 MiB dense workspace safety budget so LPSolver may use its sparse revised-simplex route."
    },
    {
      "area": "Telemetry",
      "summary": "Expose the optimal root LP bound in the MILP CLI output."
    },
    {
      "area": "QP and ordinary LP algorithms",
      "summary": "No QP or ordinary LP algorithm changes."
    }
